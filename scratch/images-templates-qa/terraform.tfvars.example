cloudstack_api_url    = "https://cloud.zcp.example/client/api"
cloudstack_api_key    = "replace-with-api-key"
cloudstack_secret_key = "replace-with-secret-key"

zone = "yow-1"

tags = {
  service = "zcp"
  env     = "qa"
}

