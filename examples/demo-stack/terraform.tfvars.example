cloudstack_api_url    = "https://cloud.zcp.example/client/api"
cloudstack_api_key    = "replace-with-api-key"
cloudstack_secret_key = "replace-with-secret-key"

# Defaults in variables.tf already use the repo-backed non-prod ZCP offerings:
# - Standard VPC offering - nonprd
# - VPC Tier

# Override networking_vpcs to create one or more VPCs from this root module.
# Example:
#
# networking_vpcs = {
#   dev = {
#     name         = "dev-vpc-01"
#     display_text = "Development VPC"
#     cidr         = "10.20.0.0/16"
#     vpc_offering = "Standard VPC offering - nonprd"
#     network_acls = {}
#     networks = {
#       web = {
#         name             = "web-tier"
#         cidr             = "10.20.1.0/24"
#         gateway          = "10.20.1.1"
#         startip          = "10.20.1.10"
#         endip            = "10.20.1.200"
#         network_offering = "VPC Tier"
#       }
#     }
#   }
# }

# Compute groups are empty by default. Each entry calls the compute module once
# and references a network created by the networking module.
#
# compute_groups = {
#   web = {
#     vpc_key                  = "demo"
#     network_key              = "web"
#     default_service_offering = "Basic"
#     default_template         = "Ubuntu 22.04"
#     create_ssh_keypair       = true
#     ssh_keypair_name         = "demo-key"
#     ssh_public_key           = "ssh-ed25519 AAAA... user@host"
#     instances = {
#       web1 = { name = "web-01" }
#       web2 = { name = "web-02", service_offering = "Standard" }
#     }
#   }
# }
