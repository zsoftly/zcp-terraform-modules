cloudstack_api_url    = "https://console.zcp.example/client/api"
cloudstack_api_key    = "replace-with-api-key"
cloudstack_secret_key = "replace-with-secret-key"

# Defaults in variables.tf already use the repo-backed non-prod ZCP offerings:
# - Standard VPC offering - nonprd
# - VPC Tier
#
# The default load_balancing_security value allocates one public IP for the demo
# web tier and creates ingress/egress firewall rules for HTTP and HTTPS.

# Override networking_vpcs to create one or more VPCs from this root module.
# Example:
#
# networking_vpcs = {
#   dev = {
#     name         = "dev-vpc-01"
#     display_text = "Development VPC"
#     cidr         = "10.20.0.0/16"
#     vpc_offering = "Standard VPC offering - nonprd"
#     network_acls = {}
#     networks = {
#       web = {
#         name             = "web-tier"
#         cidr             = "10.20.1.0/24"
#         gateway          = "10.20.1.1"
#         startip          = "10.20.1.10"
#         endip            = "10.20.1.200"
#         network_offering = "VPC Tier"
#       }
#     }
#   }
# }

# Static NAT, port forwarding, and load balancer rules need VM IDs. Add them
# here after the compute module has created instances.
#
# load_balancing_security = {
#   demo = {
#     name               = "demo-edge"
#     networking_vpc_key = "demo"
#     network_key        = "web"
#     public_ips = {
#       web = {}
#     }
#     firewalls = {
#       web = {
#         public_ip_key = "web"
#         rules = [
#           {
#             cidr_list = ["0.0.0.0/0"]
#             protocol  = "tcp"
#             ports     = ["80", "443"]
#           }
#         ]
#       }
#     }
#     load_balancer_rules = {
#       https = {
#         name          = "demo-https"
#         description   = "Demo HTTPS load balancer"
#         public_ip_key = "web"
#         algorithm     = "roundrobin"
#         public_port   = 443
#         private_port  = 443
#         member_ids    = ["vm-id-1", "vm-id-2"]
#       }
#     }
#   }
# }

# Storage is empty by default. Enable this block only when you want to create
# volumes. Leave attach=false for volume-only tests before the compute module is
# available. Keep snapshot_policies={} until the volume is attached or you have
# an existing Ready volume_id.
#
# storage_stacks = {
#   demo = {
#     volumes = {
#       app_data = {
#         name          = "demo-app-data-01"
#         disk_offering = "Starter-NVMe"
#         attach        = false
#       }
#     }
#
#     snapshot_policies = {}
#
#     restored_volumes = {}
#   }
# }

# CKS service and Kubernetes versions must already be enabled/registered in
# CloudStack before this can be applied. For ZCP defaults, do not point CKS at
# the demo VPC tier network. If network_id is set, it must be a supported CKS
# isolated network.
kubernetes_clusters = {
  demo = {
    name               = "demo-cks-01"
    description        = "Demo CKS cluster"
    kubernetes_version = "1.34.3"
    service_offering   = "CKS Node - Intel nonprd"
    worker_count       = 2
    # network_id = "supported-cks-isolated-network-id"
  }
}
