cloudstack_api_url    = "https://your-zcp-endpoint/client/api"
cloudstack_api_key    = "your-api-key"
cloudstack_secret_key = "your-secret-key"
zone                  = "your-zone-name"
stack                 = "docker"
hostname              = "test-vm.example.com"
stack_vars            = {}

# Optional: override template names if your ZCP zone uses different naming
# template_name_overrides = {
#   docker = "Ubuntu-24.04-LTS"
#   cpanel = "AlmaLinux-9"
# }
