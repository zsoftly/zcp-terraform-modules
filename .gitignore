# ──────────────────────────────────────────────
# Terraform / OpenTofu
# ──────────────────────────────────────────────
**/.terraform/*

# Lock files in child modules (lock files belong only in root modules)
modules/*/.terraform.lock.hcl

# Terraform state and plans
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
plan.out
plan.json
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ──────────────────────────────────────────────
# Sensitive / credentials
# ──────────────────────────────────────────────
**/.env
**/.env.*
*.pem
*.key

# ──────────────────────────────────────────────
# OS / editor
# ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*~
.directory
*.swp
*.swo
*.bak
.~lock.*

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
*.log
node_modules/
scratch/
tmp/
!tmp/.gitkeep
.claude/settings.local.json
IMPLEMENTATION_SUMMARY_*.md
