#cloud-config
# ZCP Stack: ${stack}
# Do not edit this file on the VM — it is rendered by Terraform at provision time.
#
# USAGE: Copy this file to <stack-name>.tftpl and add stack-specific runcmd steps
# between the idempotency guard and the provisioning-complete marker.

hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

write_files:
  - path: /etc/zcp/stack
    content: |
      STACK=${stack}
      PROVISIONED=false
    permissions: '0644'
    owner: root:root

runcmd:
  # Idempotency guard — copy this block verbatim to every stack script
  - |
    if [ -f /var/lib/zcp-provisioned ]; then
      echo "[ZCP] Already provisioned, skipping." | tee -a /var/log/zcp-provision.log
      exit 0
    fi
  - mkdir -p /etc/zcp
  - echo "[ZCP] Starting ${stack} provision at $(date)" | tee -a /var/log/zcp-provision.log

  #
  # ---- ADD STACK-SPECIFIC COMMANDS HERE ----
  #

  # Mark provisioning complete — copy this block verbatim, always last
  - sed -i 's/PROVISIONED=false/PROVISIONED=true/' /etc/zcp/stack
  - touch /var/lib/zcp-provisioned
  - echo "[ZCP] Provisioning complete at $(date)" | tee -a /var/log/zcp-provision.log
