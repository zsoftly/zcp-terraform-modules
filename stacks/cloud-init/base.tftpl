#cloud-config
# ACS Stack: ${stack}
# Do not edit this file on the VM — it is rendered by Terraform at provision time.

hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

write_files:
  - path: /etc/acs/stack
    content: |
      STACK=${stack}
      PROVISIONED=false
    permissions: '0644'
    owner: root:root

runcmd:
  # Idempotency guard — copy this block verbatim to every stack script
  - |
    if [ -f /var/lib/acs-provisioned ]; then
      echo "[ACS] Already provisioned, skipping." | tee -a /var/log/acs-provision.log
      exit 0
    fi
  - mkdir -p /etc/acs
  - echo "[ACS] Starting ${stack} provision at $(date)" | tee -a /var/log/acs-provision.log

  #
  # ---- ADD STACK-SPECIFIC COMMANDS HERE ----
  #

  # Mark provisioning complete — copy this block verbatim, always last
  - sed -i 's/PROVISIONED=false/PROVISIONED=true/' /etc/acs/stack
  - touch /var/lib/acs-provisioned
  - echo "[ACS] Provisioning complete at $(date)" | tee -a /var/log/acs-provision.log
